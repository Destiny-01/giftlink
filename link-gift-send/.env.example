# One switch decides the whole frontend: testnet or mainnet. The app refuses to start (rendering a
# "Configuration error" screen listing the variable names) when any required variable is missing or
# invalid. There are no network defaults.

# "testnet" or "mainnet". Required. Sets the chain ID (testnet 5042002, mainnet 5042).
VITE_ARC_NETWORK=testnet

# Optional. When set, must equal the selected network's chain ID.
VITE_ARC_CHAIN_ID=

# Arc JSON-RPC endpoint. Required, no default.
VITE_ARC_RPC_URL=https://rpc.testnet.arc.network

# Block explorer base URL; a trailing slash is normalized away. Required, no default.
VITE_ARC_EXPLORER_URL=https://testnet.arcscan.app

# Backend API base URL. Required, no default.
VITE_API_URL=https://api.giftlink.arc

# Nomine Claim Core contract address (0x-address). Required, no default.
VITE_CLAIM_CORE_ADDRESS=0x...

# Arc USDC ERC-20 contract address (0x-address). Required, no default.
VITE_USDC_CONTRACT_ADDRESS=0x...

# Privy app ID (OAuth). Required. Get yours from https://privy.io.
VITE_PRIVY_APP_ID=your_privy_app_id

# Legacy GiftLink drop contract address.
VITE_GIFTLINK_CONTRACT_ADDRESS=0x...
