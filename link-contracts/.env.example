# Nomine Claim Core — deployment environment
#
# Every value here is required for a real deployment. Nothing is defaulted and
# nothing is inferred; see config/arc.ts and scripts/deploy.ts.

# JSON-RPC endpoint for the target Arc network. Required. Never committed.
ARC_TESTNET_RPC_URL=
ARC_MAINNET_RPC_URL=

# Deployer key. Required only to broadcast. Never committed, never logged.
DEPLOYER_PRIVATE_KEY=

# Explorer API key for contract verification, if the explorer provides one.
ARC_EXPLORER_API_KEY=

# Broadcast gate. Deployment does nothing but preflight unless this is exactly "1".
# Mainnet additionally requires the explicit approval value.
ARC_DEPLOY_CONFIRM=0
ARC_MAINNET_APPROVED=no
