{
  "name": "nomine-claim-core",
  "version": "1.0.0",
  "private": true,
  "description": "Nomine Claim Core: immutable, fully funded USDC campaigns with dual EIP-712 attestations on Arc",
  "license": "UNLICENSED",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "export-abi": "hardhat run scripts/export-abi.ts",
    "preflight:testnet": "hardhat run scripts/deploy.ts",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network arcTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network arcMainnet",
    "example": "hardhat run scripts/claim-lifecycle-example.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.7",
    "@nomicfoundation/hardhat-ethers": "^3.0.6",
    "@nomicfoundation/hardhat-verify": "^2.0.9",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.10",
    "chai": "^4.4.1",
    "ethers": "^6.13.2",
    "hardhat": "^2.22.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
